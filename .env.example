# -----------------------------------------------------------------------------
# Gluten Defender — environment variables
# -----------------------------------------------------------------------------
# HOW TO USE:
#   1. Copy this file to a new file named ".env.local"   (cp .env.example .env.local)
#   2. Fill in the real values from your Supabase project (see README).
#   3. Restart the dev server so Next.js picks up the changes.
#
# ".env.local" is git-ignored on purpose so your values are never committed.
# The "NEXT_PUBLIC_" prefix means the value is exposed to the browser. That is
# fine for these two — the anon key is designed to be public.
# -----------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase "anon" / publishable public API key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your Supabase Service Role key (needed for server-side cache writes later).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public URL where this app is reachable. Used by Supabase to construct
# email confirmation links (signup, password reset). MUST match where users
# actually access the app.
# - Local development: http://localhost:3000
# - Production: https://gluten-defender.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
